# ==========================================
# TaskFlow Environment Configuration Example
# Copy this file to .env for local development
# Note: Never commit real credentials to version control.
# ==========================================

# Core Application Settings
APP_NAME=TaskFlow
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database Configuration
# Local SQLite default:
DATABASE_URL=sqlite:///./taskflow.db
# PostgreSQL example for production/staging:
# DATABASE_URL=postgresql://taskflow_user:taskflow_password@localhost:5432/taskflow_db

# PostgreSQL Container Credentials (for Docker Compose)
POSTGRES_USER=taskflow_user
POSTGRES_PASSWORD=taskflow_password
POSTGRES_DB=taskflow_db

# In-Memory Cache & Message Broker (Redis)
REDIS_URL=redis://localhost:6379/0

# Reverse Proxy & Security (Comma-separated trusted proxy IPs)
TRUSTED_PROXIES=127.0.0.1,::1,localhost,testclient

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Frontend Configuration (Vite)
VITE_API_URL=http://localhost:8000
